{
  "manifest_version": 3,
  "name": "XDM Download Controller",
  "description": "View and control Xtreme Download Manager downloads.",
  "version": "1.3.1",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8597/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "XDM Download Controller",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
